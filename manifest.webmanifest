{"id": "/", "name": "Madrid de Noche", "short_name": "MdN", "start_url": "./", "scope": "./", "display": "standalone", "background_color": "#0a0a0f", "theme_color": "#0a0a0f", "lang": "es", "description": "Todos los eventos de ocio nocturno de Madrid en un sitio: discotecas, conciertos, tardeos y fiestas con precio, música, dress code, edad y enlace de compra. Actualizado cada día.", "icons": [{"src": "icono-192.png", "sizes": "192x192", "type": "image/png"}, {"src": "icono-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"}]}